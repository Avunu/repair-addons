<odoo>
    <record id="repair_order_stage_view_list" model="ir.ui.view">
        <field name="name">repair.order.stage.list</field>
        <field name="model">repair.order.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="state" />
                <field name="fold" />
            </list>
        </field>
    </record>

    <record id="repair_order_stage_view_form" model="ir.ui.view">
        <field name="name">repair.order.stage.form</field>
        <field name="model">repair.order.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="fold" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <field name="description" placeholder="What this stage means for the shop..." />
                </sheet>
            </form>
        </field>
    </record>

    <record id="repair_order_stage_view_search" model="ir.ui.view">
        <field name="name">repair.order.stage.search</field>
        <field name="model">repair.order.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="repair_order_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">repair.order.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a repair stage</p>
            <p>Stages are the columns of the repairs board. Each one belongs to
               a repair status; several stages can share a status.</p>
        </field>
    </record>

    <menuitem
        id="repair_order_stage_menu"
        name="Stages"
        parent="repair.repair_menu_config"
        action="repair_order_stage_action"
        sequence="0"
    />
</odoo>
