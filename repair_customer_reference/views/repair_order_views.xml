<odoo>
    <record id="view_repair_order_form" model="ir.ui.view">
        <field name="name">repair.order.form.customer.reference</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='tag_ids']" position="after">
                <field name="client_order_ref" />
            </xpath>
        </field>
    </record>
    <record id="view_repair_order_tree" model="ir.ui.view">
        <field name="name">repair.order.list.customer.reference</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="client_order_ref" optional="hide" />
            </field>
        </field>
    </record>
    <record id="view_repair_order_search" model="ir.ui.view">
        <field name="name">repair.order.search.customer.reference</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="client_order_ref" />
            </field>
        </field>
    </record>
</odoo>
