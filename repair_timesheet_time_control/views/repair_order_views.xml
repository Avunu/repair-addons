<odoo>
    <!-- Inherits repair_timesheet's view rather than the base repair form so
         the Timesheets tab is guaranteed to be there to hang buttons on. -->
    <record id="view_repair_order_form" model="ir.ui.view">
        <field name="name">repair.order.form (in repair_timesheet_time_control)</field>
        <field name="model">repair.order</field>
        <field
            name="inherit_id"
            ref="repair_timesheet.repair_order_form_view_timesheet_inherit"
        />
        <field name="arch" type="xml">
            <!-- Last in the header, so the timer sits after the state actions
                 and does not get mistaken for Start/End Repair. -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field
                    name="show_time_control"
                    invisible="1"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
                <button
                    name="button_start_work"
                    string="Start Timer"
                    type="object"
                    icon="fa-play-circle"
                    invisible="show_time_control != 'start'"
                    title="Start working on this repair order"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
                <button
                    name="button_end_work"
                    string="Stop Timer"
                    type="object"
                    icon="fa-stop-circle"
                    class="oe_highlight"
                    invisible="show_time_control != 'stop'"
                    title="Stop the running timer"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
            </xpath>
            <!-- Per-line controls, so a technician can pick an earlier stint
                 back up without leaving the repair order. -->
            <xpath
                expr="//field[@name='timesheet_ids']/list/field[@name='date']"
                position="after"
            >
                <field name="date_time" string="Started" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/list" position="inside">
                <field
                    name="show_time_control"
                    column_invisible="1"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
                <button
                    name="button_resume_work"
                    title="Resume work"
                    tabindex="-1"
                    type="object"
                    icon="fa-play-circle text-success"
                    invisible="show_time_control != 'resume'"
                    class="oe_stat_button"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
                <button
                    name="button_end_work"
                    title="Stop work"
                    tabindex="-1"
                    type="object"
                    icon="fa-stop-circle text-warning"
                    invisible="show_time_control != 'stop'"
                    class="oe_stat_button"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
