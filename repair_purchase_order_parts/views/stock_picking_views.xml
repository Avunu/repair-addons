<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_add_to_repair" model="ir.ui.view">
        <field name="name">stock.picking.form.add.to.repair</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[last()]" position="after">
                <button
                    name="action_add_to_repair"
                    string="Add to Repair"
                    type="object"
                    invisible="state != 'done' or not purchase_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
