<odoo>
    <record id="view_repair_order_template_form" model="ir.ui.view">
        <field name="name">repair.order.template.form.services</field>
        <field name="model">repair.order.template</field>
        <field
            name="inherit_id"
            ref="repair_order_template.view_repair_order_template_form"
        />
        <field name="arch" type="xml">
            <page name="line_ids" position="after">
                <page name="service_line_ids" string="Services">
                    <field name="service_line_ids">
                        <list editable="bottom">
                            <field name="product_id" />
                            <field name="name" optional="hide" />
                            <field
                                name="product_uom_category_id"
                                column_invisible="1"
                            />
                            <field name="product_uom" groups="uom.group_uom" />
                            <field name="product_uom_qty" />
                            <field name="company_id" column_invisible="1" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
