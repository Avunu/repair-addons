        "repair_purchase_order_parts/i18n",
        "repair_purchase_order_parts/i18n_extra",
        "repair_purchase_order_parts/static/description"
      ]
    },
    "repair_service_so_sync": {
      "component": "repair_service_so_sync-18.0",
      "exclude-paths": [
        "repair_service_so_sync/tests",
        "repair_service_so_sync/readme",
        "repair_service_so_sync/i18n",
        "repair_service_so_sync/i18n_extra",
        "repair_service_so_sync/static/description"
      ]
    },
    "repair_stage": {
      "component": "repair_stage-18.0",
      "exclude-paths": [
        "repair_stage/tests",
