{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "tag-separator": ".",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(release): release ${branch}",
  "pull-request-header": "Merging this releases the addons below on 18.0: release-please tags each `<addon>-18.0.x.y.z` and publishes its GitHub release, which carries the addon's zip and wheel.",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    }
  ],
  "packages": {
    "repair_fleet_vehicle": {
      "component": "repair_fleet_vehicle-18.0",
      "exclude-paths": [
        "repair_fleet_vehicle/tests",
        "repair_fleet_vehicle/readme",
        "repair_fleet_vehicle/i18n",
        "repair_fleet_vehicle/i18n_extra",
        "repair_fleet_vehicle/static/description"
      ]
    },
    "repair_order_template_service": {
      "component": "repair_order_template_service-18.0",
      "exclude-paths": [
        "repair_order_template_service/tests",
        "repair_order_template_service/readme",
        "repair_order_template_service/i18n",
        "repair_order_template_service/i18n_extra",
        "repair_order_template_service/static/description"
      ]
    },
    "repair_purchase_order_parts": {
